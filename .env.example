# Core runtime
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DB_URL=postgresql://postgres.YOUR_PROJECT_REF:***@YOUR_POOLER_HOST:6543/postgres
HERMES_OWNER_USER_ID=YOUR_OWNER_USER_UUID

# Machine-to-machine auth
HERMES_API_KEY=GENERATE_A_LONG_RANDOM_SECRET
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Token encryption at rest
TOKEN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Meta app
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# AI content generation — used by content/generate, threads/engage, threads-auto-reply
# Set AI_BASE_URL to your OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1)
# Leave unset to disable AI features (auto-reply falls back to draft-only / skipped mode)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=marketku/mk/haiku-4.5
BIRRULABS_API_KEY=

# Auto-reply: max AI-generated replies per day per account (default: 10)
AUTO_REPLY_MAX_PER_DAY=10

# Scheduler live-publish guard (default: false — drafts only)
SCHEDULER_LIVE_PUBLISH=false

# NextAuth / dashboard (only if dashboard auth is enabled)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Cloudflare Workers AI (optional — image generation)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Development/testing only. NEVER enable in production.
ALLOW_MOCK_SUPABASE=false
