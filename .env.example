# Core runtime & URL
APP_URL=https://meta-automation-saas.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DB_URL=postgresql://postgres.YOUR_PROJECT_REF:***@YOUR_POOLER_HOST:6543/postgres
HERMES_OWNER_USER_ID=YOUR_OWNER_USER_UUID

# Machine-to-machine auth
HERMES_API_KEY=GENERATE_A_LONG_RANDOM_SECRET
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Token encryption at rest (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Meta Developer App (Unified or Dedicated)
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_GRAPH_VERSION=v23.0
META_FACEBOOK_REDIRECT_URI=https://meta-automation-saas.vercel.app/api/oauth/facebook/callback

# Instagram API (Optional override if separate from META_APP_ID)
IG_APP_ID=YOUR_IG_APP_ID
IG_APP_SECRET=YOUR_IG_APP_SECRET
IG_REDIRECT_URI=https://meta-automation-saas.vercel.app/api/oauth/instagram/callback

# Threads API (Optional override if separate from META_APP_ID)
THREADS_APP_ID=2078424476129562
THREADS_APP_SECRET=YOUR_THREADS_APP_SECRET
THREADS_REDIRECT_URI=https://meta-automation-saas.vercel.app/api/oauth/threads/callback

# AI content generation — OpenRouter / OpenAI-compatible / Gemini
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=marketku/mk/haiku-4.5
BIRRULABS_API_KEY=

# Auto-reply: max AI-generated replies per day per account (default: 10)
AUTO_REPLY_MAX_PER_DAY=10

# Scheduler live-publish guard (default: false — drafts only, set true for production)
SCHEDULER_LIVE_PUBLISH=false

# NextAuth / dashboard
NEXTAUTH_URL=https://meta-automation-saas.vercel.app
NEXTAUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Cloudflare Workers AI (optional — image generation)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Development/testing only. NEVER enable in production.
ALLOW_MOCK_SUPABASE=false
